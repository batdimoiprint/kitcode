#!/usr/bin/env python3
"""
kitcode-tree: Collapsible directory tree for kitcode IDE with Git badges, search & preview routing.
"""

import os
import sys
from pathlib import Path

# Add shared lib directory
LIB_DIR = Path(__file__).resolve().parent.parent / "lib"
sys.path.insert(0, str(LIB_DIR))

from kitcode_core import KitcodeTreeApp


def main():
    default_dir = os.environ.get("KITCODE_ROOT", ".")
    target = sys.argv[1] if len(sys.argv) > 1 else default_dir
    app = KitcodeTreeApp(root_dir=target)
    app.run()


if __name__ == "__main__":
    main()
